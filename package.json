{
  "name": "codeforge-studio",
  "version": "1.0.0",
  "description": "Современный блокнот с возможностью компиляции кода",
  "author": "Aleksey Volkov",
  "repository": "https://github.com/Alexiisssss/CodeForgeStudio",
  "homepage": ".",
  "main": "public/electron.js",
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "postinstall": "node -e \"var fs=require('fs'),path=require('path'); var s=path.join(process.cwd(),'node_modules','sql.js','dist','sql-wasm.wasm'); var d=path.join(process.cwd(),'public','sql-wasm.wasm'); if(fs.existsSync(s)){fs.copyFileSync(s,d); console.log('sql-wasm.wasm -> public');} else {console.warn('sql.js not installed: run npm install');}\"",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-pack": "npm run build && electron-builder",
    "electron-pack-win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.7.1",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.2.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.6",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.1.7",
    "@codemirror/lang-python": "^6.1.3",
    "@codemirror/language": "^6.9.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.21.0",
    "@lezer/highlight": "^1.1.0",
    "@uiw/react-codemirror": "^4.21.0",
    "iconv-lite": "^0.7.2",
    "oracledb": "^6.10.0",
    "pg": "^8.17.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "concurrently": "^8.2.2",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
